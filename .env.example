# Copy to .env and adjust. Local dev needs none of these — it uses a local SQLite file.

PORT=8000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave BLANK for local dev (uses a file at data/readin52.db).
# For production, point at your Turso database:
#   DATABASE_URL=libsql://your-db-name-you.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Default admin created on first boot when the DB has no users (change after first login)
ADMIN_EMAIL=setup@localhost
ADMIN_PASSWORD=ChangeMe52!

# Copy to .env and adjust. Local dev needs none of these — it uses a local SQLite file.

PORT=8000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave BLANK for local dev (uses a file at data/readin52.db).
# For production, point at your Turso database:
#   DATABASE_URL=libsql://your-db-name-you.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Default admin created on first boot when the DB has no users (change after first login)
ADMIN_EMAIL=setup@localhost
ADMIN_PASSWORD=ChangeMe52!

# --- Transactional email (Resend) ---
# Without these, email is skipped (forgot-password shows a dev link locally).
#   RESEND_API_KEY=re_xxxxxxxx
#   EMAIL_FROM=ReadIn52 <noreply@askdevotions.com>
RESEND_API_KEY=
EMAIL_FROM=

# Optional: canonical public URL used in email links (else derived from the request)
# APP_URL=https://readin52.askdevotions.com

# --- Bot protection (Cloudflare Turnstile) ---
# Without both, signup/login are not bot-protected. Get keys from
# https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

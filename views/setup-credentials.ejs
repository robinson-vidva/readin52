<%- include('partials/head') %>
<body>
<%- include('partials/header') %>
<main class="auth-wrap">
  <div class="auth-card">
    <h1>Set up your account</h1>
    <p class="muted">For security, please choose your own name, email and password before continuing.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/setup-credentials" class="stack">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
      <label>Name<input type="text" name="name" required autofocus /></label>
      <label>Email<input type="email" name="email" required /></label>
      <label>Password<input type="password" name="password" minlength="6" required /></label>
      <label>Confirm password<input type="password" name="password_confirm" minlength="6" required /></label>
      <button type="submit" class="btn btn-primary btn-block">Save and continue</button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>

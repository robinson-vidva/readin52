<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<main class="container app-main">
  <div class="page-head"><h1>Admin</h1></div>
  <%- include('../partials/admin-nav') %>
  <section class="stat-row">
    <div class="stat card"><span class="stat-ico">👥</span><div><strong><%= userCount %></strong><small>Users</small></div></div>
    <div class="stat card"><span class="stat-ico">📖</span><div><strong><%= globalStats.active_readers %></strong><small>Active readers</small></div></div>
    <div class="stat card"><span class="stat-ico">✅</span><div><strong><%= globalStats.total_completed %></strong><small>Readings completed</small></div></div>
    <div class="stat card"><span class="stat-ico">🏁</span><div><strong><%= globalStats.completed_plan %></strong><small>Finished the plan</small></div></div>
  </section>
  <section class="card">
    <div class="card-head"><h2>Newest users</h2><a href="/admin/users" class="btn btn-ghost btn-sm">Manage all</a></div>
    <table class="table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
          <tr><td><%= u.name %></td><td><%= u.email %></td><td><span class="pill <%= u.role %>"><%= u.role %></span></td><td><%= new Date(u.created_at + 'Z').toLocaleDateString() %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </section>
</main>
<%- include('../partials/footer') %>

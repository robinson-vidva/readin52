<%- include('partials/head') %>
<body class="reader-body">
<%- include('partials/header') %>
<% const byLang = {}; translations.forEach(function(t){ (byLang[t.language] = byLang[t.language] || []).push(t); }); const langNames = Object.keys(byLang); %>
<main class="reader" id="reader"
      data-book="<%= book %>" data-chapter="<%= chapter %>"
      data-bookname="<%= bookName %>" data-total="<%= totalChapters %>">

  <div class="reader-toolbar">
    <div class="rt-left">
      <button class="icon-btn rt-title" id="rBookBtn"><span id="rTitleText"><%= bookName %> <%= chapter %></span> ▾</button>
    </div>
    <div class="rt-center">
      <select id="rTranslation" class="select-sm" aria-label="Translation">
        <% langNames.forEach(function(lang){ %><optgroup label="<%= lang %>"><% byLang[lang].forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %></optgroup><% }); %>
      </select>
      <button class="icon-btn" id="rDualBtn" title="Compare a second translation">＋ Compare</button>
      <select id="rSecondary" class="select-sm" aria-label="Second translation" hidden>
        <% langNames.forEach(function(lang){ %><optgroup label="<%= lang %>"><% byLang[lang].forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %></optgroup><% }); %>
      </select>
    </div>
    <div class="rt-right">
      <button class="icon-btn" id="rBookmark" title="Bookmark this chapter" aria-pressed="false">☆</button>
      <button class="icon-btn" id="rListenBtn" title="Listen — read aloud" aria-label="Listen">
        <svg class="ico ico-listen"><use href="#i-headphones"/></svg>
        <svg class="ico ico-stop"><use href="#i-stop"/></svg>
      </button>
      <button class="icon-btn" id="rNotesBtn" title="Your notes here"><svg class="ico"><use href="#i-pen"/></svg> <span id="rNoteCount"></span></button>
      <button class="icon-btn" id="rLayoutBtn" title="Verse-by-verse layout" aria-label="Reading layout">
        <svg class="ico ico-verse"><use href="#i-list"/></svg>
        <svg class="ico ico-para"><use href="#i-paragraph"/></svg>
      </button>
      <div class="type-controls">
        <button class="icon-btn" id="rFontDown" title="Smaller text">A−</button>
        <button class="icon-btn" id="rFontFamily" title="Toggle serif / sans">Aa</button>
        <button class="icon-btn" id="rFontUp" title="Larger text">A+</button>
      </div>
      <button class="icon-btn" id="rFocus" title="Focus mode">⛶</button>
    </div>
  </div>

  <div class="reader-layout" id="readerLayout">
    <div class="reader-scroll" id="readerScroll">
      <article class="reader-page" id="readerContent"><div class="reader-loading">Loading…</div></article>
      <div class="load-sentinel" id="loadSentinel"></div>
      <div class="reader-end" id="readerEnd" hidden>You've reached the end of the Bible. <a href="/reader/GEN/1">Start again at Genesis →</a></div>
    </div>

    <!-- Study panel: cross references + verse actions -->
    <aside class="study-panel" id="studyPanel" hidden>
      <div class="sp-head">
        <div><span class="sp-eyebrow">Study</span><strong id="spRef">—</strong></div>
        <button class="icon-btn" id="spClose" aria-label="Close">✕</button>
      </div>

      <div class="sp-verse" id="spVerse"></div>

      <div class="sp-actions">
        <div class="sp-hl" id="spHighlight">
          <% ['yellow','green','blue','red','purple'].forEach(function(c){ %>
            <button class="hl-swatch c-<%= c %>" data-color="<%= c %>" title="Highlight <%= c %>"></button>
          <% }); %>
          <button class="hl-swatch hl-clear" data-color="" title="Clear highlight">✕</button>
        </div>
        <div class="sp-btns">
          <button class="chip-btn" id="spNoteBtn"><svg class="ico"><use href="#i-pen"/></svg> Note</button>
          <button class="chip-btn" id="spCopyBtn">⧉ Copy</button>
          <button class="chip-btn" id="spShareBtn">⤴ Share</button>
        </div>
      </div>

      <form class="sp-noteform" id="spNoteForm" hidden>
        <input type="hidden" id="spNoteId" />
        <input type="text" id="spNoteTitle" placeholder="Note title" />
        <textarea id="spNoteContent" rows="3" placeholder="Write a reflection on this verse…"></textarea>
        <div class="sp-noteactions"><button type="submit" class="btn btn-primary btn-sm">Save note</button><button type="button" class="btn btn-ghost btn-sm" id="spNoteCancel">Cancel</button></div>
      </form>

      <% if (typeof ai !== 'undefined' && ai.enabled) { %>
      <div class="sp-section sp-ai">
        <h4 class="sp-title">Study companion <span class="sp-hint">AI</span></h4>
        <div class="sp-btns">
          <button class="chip-btn" id="spExplainBtn"><svg class="ico"><use href="#i-compass"/></svg> Explain this verse</button>
        </div>
        <form class="sp-ai-ask" id="spAiForm">
          <input type="text" id="spAiInput" placeholder="Ask about this verse…" autocomplete="off" />
          <button class="chip-btn" type="submit">Ask</button>
        </form>
        <div class="sp-ai-body" id="spAiBody" hidden></div>
        <p class="sp-ai-note">AI-generated — weigh it against Scripture.</p>
      </div>
      <% } %>

      <div class="sp-section">
        <h4 class="sp-title">Cross references <span class="sp-hint">related passages</span></h4>
        <div id="spRefs" class="sp-refs"><p class="muted small">Tap a verse to see related passages.</p></div>
      </div>

      <div class="sp-section sp-commentary">
        <h4 class="sp-title">Commentary
          <select id="spCommentarySel" class="select-sm">
            <option value="">— Off —</option>
            <option value="matthew-henry">Matthew Henry</option>
            <option value="adam-clarke">Adam Clarke</option>
            <option value="john-calvin">John Calvin</option>
            <option value="john-gill">John Gill</option>
            <option value="jamieson-fausset-brown">Jamieson-Fausset-Brown</option>
            <option value="keil-delitzsch">Keil &amp; Delitzsch (OT)</option>
            <option value="tyndale">Tyndale Study Notes</option>
          </select>
        </h4>
        <div id="spCommentary" class="sp-commentary-body"><p class="muted small">Choose a commentary to see notes on this verse.</p></div>
      </div>

      <div class="sp-notes" id="spNotes"></div>
    </aside>
  </div>

  <!-- Book picker -->
  <div class="picker-backdrop" id="bookPicker" hidden>
    <div class="picker">
      <div class="picker-head"><input type="text" id="bookSearch" placeholder="Search books…" /><button class="icon-btn" id="bookPickerClose">✕</button></div>
      <div class="picker-body" id="bookList"></div>
    </div>
  </div>

  <button class="study-fab" id="studyFab" hidden aria-label="Open study panel"><svg class="ico" style="width:24px;height:24px"><use href="#i-book"/></svg></button>
</main>
<%- include('partials/footer') %>

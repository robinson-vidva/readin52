<%- include('partials/head') %>
<body>
<%- include('partials/header') %>
<main class="auth-wrap">
  <div class="auth-card">
    <h1>Reset your password</h1>
    <p class="muted">Enter your email and we'll generate a reset link.</p>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
      <% if (typeof devLink !== 'undefined' && devLink) { %>
        <div class="alert alert-info">Email isn't configured in this build, so here is your reset link:
          <a href="<%= devLink %>">Reset password</a></div>
      <% } %>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/forgot-password" class="stack">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
      <label>Email<input type="email" name="email" required autofocus /></label>
      <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
    </form>
    <div class="auth-links"><a href="/login">Back to sign in</a></div>
  </div>
</main>
<%- include('partials/footer') %>

<% const isAuthed = !!currentUser; %>
<%- include('icons') %>
<header class="site-header">
  <div class="header-inner">
    <a href="<%= isAuthed ? '/dashboard' : '/' %>" class="brand">
      <img src="/static/icons/icon.svg" alt="" class="brand-mark" width="30" height="30" />
      <span class="brand-name"><%= app.appName %></span>
    </a>

    <% if (isAuthed) { %>
      <nav class="main-nav" aria-label="Primary">
        <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Plan</a>
        <a href="/books" class="<%= (path === '/books' || path.startsWith('/reader')) ? 'active' : '' %>">Read</a>
        <a href="/notes" class="<%= path === '/notes' ? 'active' : '' %>">Notes</a>
        <a href="/stats" class="<%= path === '/stats' ? 'active' : '' %>">Stats</a>
        <a href="/achievements" class="<%= path === '/achievements' ? 'active' : '' %>">Badges</a>
        <% if (currentUser.role === 'admin') { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
      </nav>
      <div class="header-actions">
        <button type="button" class="icon-btn" id="quickJumpBtn" title="Quick jump (⌘K)" aria-label="Quick jump">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <button type="button" class="icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
          <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <div class="menu" id="userMenu">
          <button type="button" class="avatar-btn" id="userMenuBtn" aria-haspopup="true" aria-expanded="false">
            <span class="avatar"><%= (currentUser.name || 'U').charAt(0).toUpperCase() %></span>
          </button>
          <div class="menu-panel" role="menu">
            <div class="menu-head"><strong><%= currentUser.name %></strong><span><%= currentUser.email %></span></div>
            <a href="/settings" role="menuitem">Settings</a>
            <a href="/about" role="menuitem">About</a>
            <a href="/logout" role="menuitem" class="danger">Sign out</a>
          </div>
        </div>
        <button type="button" class="icon-btn nav-toggle" id="navToggle" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    <% } else { %>
      <div class="header-actions">
        <button type="button" class="icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
          <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <% if (app.registrationEnabled) { %><a href="/register" class="btn btn-primary btn-sm">Get started</a><% } %>
      </div>
    <% } %>
  </div>
</header>
<%- include('flash') %>

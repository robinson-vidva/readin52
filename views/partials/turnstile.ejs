<% if (typeof turnstile !== 'undefined' && turnstile && turnstile.enabled) { %>
  <div class="cf-turnstile" data-sitekey="<%= turnstile.siteKey %>" data-action="<%= typeof action !== 'undefined' ? action : 'auth' %>" data-theme="auto"></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>
